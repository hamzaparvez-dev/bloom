# Copy to `.env` in this folder (`bloom/`) and fill in values. Restart Expo after changes.
#
# Personalized “For you” insights use Supabase Edge Function `ai-personalized-insight`
# (see repo `supabase/functions/`). Set OPENAI_API_KEY as a function secret — not required
# here for that path. Keys below are only for Ask Expert (client-side) in dev.
#
# Security: embedding keys in the client bundle exposes the key in shipped apps.
# For production, remove client OPENAI_API_KEY and keep OpenAI on Edge only.

OPENAI_API_KEY=
# Optional — defaults to gpt-4o-mini (Ask Expert / legacy client only)
# OPENAI_MODEL=gpt-4o-mini
#
# UI illustrations (`bloom/assets/images/*_v*.png`): from `bloom/` run
#   npm run generate:assets
#   npm run generate:assets -- --version 2
# Stub gradients (no key): npm run generate:assets:stub

# --- Expo Go + share (tunnel = global; LAN = same Wi‑Fi only) ---
# IMPORTANT: `npx run share:expo-go` is WRONG — that is a different tool (it looks for a module file).
# Use ONE of these:
#   cd bloom && npx expo start --tunnel --go
#   cd .. && npm run share          (from repo root Pregnancy-Tracker-App/)
# Then print link for a friend (second terminal, after "Tunnel ready"):
#   cd .. && npm run share-url      (from repo root)
#   cd bloom && npm run share:expo-go:url
# Same Wi‑Fi only if ngrok is down: npm run share-lan   (from repo root)
# If tunnel fails: VPN off, different network, https://status.ngrok.com/
# postinstall in bloom patches Expo ngrok connect wait to 90s

# Required for Bloom app (Expo):
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth — Web client (Client ID + Secret) must be set in Supabase Dashboard:
#   Authentication → Providers → Google
# Keep secret server-side / in .env only (never EXPO_PUBLIC_*).
# GOOGLE_WEB_CLIENT_ID=
# GOOGLE_WEB_CLIENT_SECRET=
# Optional Android client (package com.bloom.pregnancytracker + SHA-1):
# GOOGLE_ANDROID_CLIENT_ID=

# RevenueCat (optional overrides — defaults are in app.config.js)
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=Bloom Pro
# REST API product ids (server / dashboard only; not used by the mobile SDK):
# monthly prod964ce43d36, yearly prodcd8fe3e1a0

# --- RevenueCat + native IAP (requires development build, not Expo Go) ---
# 1) npx expo prebuild          # generates ios/ + android/
# 2) npm run ios:dev            # or: npm run android:dev  (installs app with expo-dev-client)
# 3) npm run start:dev          # Metro with --dev-client (open the dev build app, not Expo Go)
# iOS: install CocoaPods first: sudo gem install cocoapods && cd ios && pod install
