{
  "name": "bloom",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "postinstall": "node ./scripts/patch-expo-ngrok-timeout.mjs",
    "start": "expo start",
    "start:dev": "expo start --dev-client",
    "start:share": "expo start --dev-client --tunnel",
    "start:go:tunnel": "expo start --tunnel --go",
    "share:expo-go": "expo start --tunnel --go",
    "share:expo-go:url": "node ./scripts/print-expo-tunnel-url.mjs",
    "share:expo-go:url:wait": "bash ./scripts/print-tunnel-after-wait.sh",
    "share:expo-go:lan": "expo start --lan --go",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "android:dev": "expo run:android",
    "ios:dev": "expo run:ios",
    "prebuild": "expo prebuild",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo/ngrok": "^4.1.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
